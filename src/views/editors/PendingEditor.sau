from uikit import *
from model import *
from editor import *
from theme import *
from widgets import *
from ResourceEditor import *

-- ============================================================================
-- PendingEditor
-- ============================================================================
--
-- For the kinds whose editor isn't built yet (sound, path, font, time line):
-- the name can already be changed, and the work area says what is coming.

export class PendingEditor extends ResourceEditor
    fn init(editor: Editor, resource: Resource, documentId: integer, key: string? = nil)
        self.super(editor, resource, documentId, key)
    end

    fn sidebarWidth() -> float
        return 200.0
    end

    fn workArea(context: BuildContext) -> View?
        local kind = self.resource.kind

        return VStack(alignment: StackAlignment.Center, sizing: StackSize.Fit, spacing: 8.0) do
            Icon(ResourceStyle.glyph(kind), 40.0, ResourceStyle.accent(kind).withAlpha(0.6))
            Label(
                "The " .. String.lower(kind.title()) .. " editor isn't built yet.",
                color: Palette.textMuted
            )
        end.centered()
    end
end
