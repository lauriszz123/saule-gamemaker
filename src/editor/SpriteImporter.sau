from shine import Graphics, Image
from model import SpriteFrame
from util import Parse

-- ============================================================================
-- SpriteImporter
-- ============================================================================
--
-- Turn a PNG on disk into sprite frames, or make a blank one.
--
-- A file named like `coin_strip8.png` is a *strip*: eight equal frames laid
-- side by side, cut here into eight `SpriteFrame`s. Anything else is a single
-- frame of the whole image.

export class SpriteImporter
    -- The frames in `path`, or nil when it isn't a readable PNG.
    static fn read(path: string) -> SpriteFrame[]?
        local image = Graphics.loadImage(path)

        if image == nil then
            return nil
        end

        local width: integer, height: integer = image!.getDimensions()
        local count = SpriteImporter.stripCount(path)

        -- A strip that doesn't divide evenly is read as one image rather
        -- than cut into frames of the wrong size.
        if count < 1 or width % count != 0 then
            count = 1
        end

        if count == 1 then
            return {SpriteFrame(image!, width, height, path)}
        end

        -- Each cell becomes an image of its own, so a frame can be edited
        -- without touching its neighbours.
        local frameWidth = width / count
        local frames: SpriteFrame[] = {}

        for i = 0, count - 1 do
            frames[#frames + 1] = SpriteFrame(
                image!.crop(i * frameWidth, 0, frameWidth, height),
                frameWidth,
                height,
                path
            )
        end

        return frames
    end

    -- A transparent frame to draw on.
    static fn blank(width: integer, height: integer) -> SpriteFrame
        return SpriteFrame(Graphics.newBlankImage(width, height), width, height)
    end

    -- 8 for "…_strip8.png", 1 for a name that isn't a strip.
    static fn stripCount(path: string) -> integer
        local found = String.match(String.lower(path), "_strip(%d+)%.png$")

        if found == nil then
            return 1
        end

        return Parse.integer(found![1]) ?? 1
    end
end
