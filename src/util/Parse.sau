-- ============================================================================
-- Parse
-- ============================================================================
--
-- Reading numbers out of text. Saule's standard library can turn a number
-- into a string (`tostring`) but has nothing for the other direction, and
-- every numeric field in the editor needs it.

export class Parse
    -- A whole number, optionally signed, with nothing else around it but
    -- spaces. Anything else — "", "-", "12px" — is nil.
    static fn integer(text: string) -> integer?
        local trimmed = String.trim(text)
        local length = String.len(trimmed)

        if length == 0 then
            return nil
        end

        local index = 1
        local negative = false
        local first = String.sub(trimmed, 1, 1)

        if first == "-" or first == "+" then
            negative = first == "-"
            index = 2
        end

        if index > length then
            return nil
        end

        local value = 0

        while index <= length do
            local code = String.byte(trimmed, index)!

            -- 48 is "0", 57 is "9".
            if code < 48 or code > 57 then
                return nil
            end

            value = value * 10 + (code - 48)
            index += 1
        end

        if negative then
            return -value
        end

        return value
    end

    -- A decimal number: "30", "-2", "0.5", ".25". Nil for anything else.
    static fn number(text: string) -> float?
        local trimmed = String.trim(text)
        local parts = String.match(trimmed, "^([+-]?)(%d*)%.?(%d*)$")

        if parts == nil or (parts![2] == "" and parts![3] == "") then
            return nil
        end

        -- A lone "." or "5." is fine; "." alone was ruled out above.
        local whole = 0.0
        local wholeDigits = parts![2]

        for i = 1, String.len(wholeDigits) do
            whole = whole * 10.0 + ((String.byte(wholeDigits, i)! - 48) as float)
        end

        local fraction = 0.0
        local scale = 1.0
        local fractionDigits = parts![3]

        for i = 1, String.len(fractionDigits) do
            scale = scale / 10.0
            fraction += ((String.byte(fractionDigits, i)! - 48) as float) * scale
        end

        local value = whole + fraction

        if parts![1] == "-" then
            return -value
        end

        return value
    end

    -- A hex number: "FF8800", "#ff8800", "0xFF8800". Nil for anything that
    -- isn't one.
    static fn hex(text: string) -> integer?
        local digits = String.trim(text)

        if String.starts(digits, "#") then
            digits = String.sub(digits, 2)
        elseif String.starts(String.lower(digits), "0x") then
            digits = String.sub(digits, 3)
        end

        local length = String.len(digits)

        if length == 0 or length > 8 then
            return nil
        end

        local value = 0

        for i = 1, length do
            local code = String.byte(digits, i)!
            local digit = -1

            -- "0"-"9", "A"-"F", "a"-"f".
            if code >= 48 and code <= 57 then
                digit = code - 48
            elseif code >= 65 and code <= 70 then
                digit = code - 55
            elseif code >= 97 and code <= 102 then
                digit = code - 87
            end

            if digit < 0 then
                return nil
            end

            value = value * 16 + digit
        end

        return value
    end
end
